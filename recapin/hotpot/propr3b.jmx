<jumbled-order-exercise><main-order><segment>Aceast&amp;#x0103;</segment>
<segment>proprietate a</segment>
<segment>adun&amp;#x0103;rii numerelor</segment>
<segment>naturale</segment>
<segment>se nume&amp;#x015F;te</segment>
<segment>asociativitate.</segment>
</main-order></jumbled-order-exercise>
</data>

<hotpot-config-file>
<jmix>
<exercise-subtitle>Reconstrui&amp;#x0163;i propozi&amp;#x0163;ia!</exercise-subtitle>
<instructions>Aranja&amp;#x0163;i cuvintele &amp;#x00EE;n ordinea corect&amp;#x0103;, plas&amp;#x00E2;nd cu mouse-ul  fiecare cuv&amp;#x00E2;nt. Ap&amp;#x0103;sa&amp;#x0163;i &quot;Verific&amp;#x0103;!&quot; pentru a verifica r&amp;#x0103;spunsul dumneavoastr&amp;#x0103;. </instructions>
<guess-correct>Corect!</guess-correct>
<guess-incorrect>Ne pare r&amp;#x0103;u! &amp;#x00CE;ncerca&amp;#x0163;i inc&amp;#x0103; o dat&amp;#x0103;.</guess-incorrect>
<this-much-correct>Aceast&amp;#x0103; parte a r&amp;#x0103;spunsului este corect&amp;#x0103;:</this-much-correct>
<next-correct-part>Urm&amp;#x0103;toarea parte a enun&amp;#x0163;ului este: </next-correct-part>
<click-to-add>Da&amp;#x0163;i click pe fiecare cuv&amp;#x00E2;nt, &amp;#x00EE;n ordinea corect&amp;#x0103;.</click-to-add>
<also-correct>Aceste r&amp;#x0103;spunsuri sunt, de asemenea, corecte:</also-correct>
<include-undo>1</include-undo>
<include-restart>1</include-restart>
<include-hint>1</include-hint>
<next-ex-url>nextpage.htm</next-ex-url>
<send-email>0</send-email>
<capitalize-first-letter>0</capitalize-first-letter>
<separate-javascript-file>0</separate-javascript-file>
</jmix>

<global>

<times-up>Your time is over!</times-up>
