<matching-exercise>
<default-right-item>???
</default-right-item>

<pair>
<left-item><text>2013 x 12 x 0 =</text>
<fixed>1</fixed>
</left-item>
<right-item><text>0 (J)</text>
<fixed>0</fixed>
</right-item></pair>

<pair>
<left-item><text>(546 - 6) : 10 =</text>
<fixed>1</fixed>
</left-item>
<right-item><text>54 (U)</text>
<fixed>0</fixed>
</right-item></pair>

<pair>
<left-item><text>29 x 7 =</text>
<fixed>1</fixed>
</left-item>
<right-item><text>203 (C)</text>
<fixed>0</fixed>
</right-item></pair>

<pair>
<left-item><text>5 x 20 - 20 = </text>
<fixed>1</fixed>
</left-item>
<right-item><text>80 (&amp;#x0102;)</text>
<fixed>0</fixed>
</right-item></pair>

<pair>
<left-item><text>100 : 10 + 1 = </text>
<fixed>1</fixed>
</left-item>
<right-item><text>11 (R)</text>
<fixed>0</fixed>
</right-item></pair>

<pair>
<left-item><text>421 - 60 x 7 =</text>
<fixed>1</fixed>
</left-item>
<right-item><text>1 (I)</text>
<fixed>0</fixed>
</right-item></pair>

<pair>
<left-item><text>98 + 102 : 2 =</text>
<fixed>1</fixed>
</left-item>
<right-item><text>149 (I)</text>
<fixed>0</fixed>
</right-item></pair>
</matching-exercise>
</data>

<hotpot-config-file>
<jmatch>
<exercise-subtitle>SUCCES!</exercise-subtitle>
<instructions>Efectua&amp;#x0163;i calculele, apoi plasa&amp;#x0163;i cu ajutorul mouse-ului r&amp;#x0103;spunsul corect &amp;#x00EE;n dreptul fiec&amp;#x0103;rui exerci&amp;#x0163;iu. Astfel ve&amp;#x0163;i descoperi un cuv&amp;#x00E2;nt magic!</instructions>
<next-ex-url>nextpage.htm</next-ex-url>
<send-email>0</send-email>
